# Copy to ".env.local" in this folder (same directory as package.json).
# Get a key: https://aistudio.google.com/apikey
#
# Must look exactly like this (name = value, no quotes unless needed):
GEMINI_API_KEY=

# OpenAI API key for Whisper voice transcription during onboarding
OPENAI_API_KEY=

# Optional. Default is gemini-2.0-flash. Use gemini-1.5-flash if you hit free-tier quota on 2.0.
# GEMINI_MODEL=gemini-1.5-flash

# Firebase web app config. Anonymous Auth + Firestore power saved progress,
# meetings, custom customers, sessions, and Ask Sales AI history.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
